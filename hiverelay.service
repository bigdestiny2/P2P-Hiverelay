[Unit]
Description=HiveRelay — P2P Relay Backbone
Documentation=https://github.com/hiverelay/hiverelay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hiverelay
Group=hiverelay

# Paths — adjust to your installation
ExecStart=/usr/bin/node /opt/hiverelay/cli/index.js start --storage /var/lib/hiverelay
WorkingDirectory=/opt/hiverelay

# Environment
Environment=NODE_ENV=production
Environment=HIVERELAY_LOG_LEVEL=info

# ─── Utility services (enabled by default across the fleet) ────────
# These make the relay useful to all apps on the substrate.
Environment=HIVERELAY_ENABLE_SERVICES=1
Environment=HIVERELAY_OUTBOXLOG=1
Environment=HIVERELAY_OUTBOXLOG_JOURNAL=hypercore-outboxes
Environment=HIVERELAY_OUTBOXLOG_MAX_JOURNAL_STORAGE=512MB
Environment=HIVERELAY_NOTIFY=1
# Real APNs/FCM/WebPush egress: mount an owner-readable JSON descriptor, then
# set Environment=HIVERELAY_NOTIFY_PUSH_CONFIG=/etc/hiverelay/notify-push.json
Environment=HIVERELAY_STORAGE_PROOF=1
Environment=HIVERELAY_VRF=1
Environment=HIVERELAY_WITNESSLOG=1
Environment=HIVERELAY_REPAIRTICKET=1
# Shard-store is opt-in per relay (needs disk space for blind custody).
# Enable on high-capacity relays: HIVERELAY_SHARD_STORE=1

# ─── Tor (enabled by default — relay IP hidden from peers) ────────
# Requires tor >= 0.4.9.5 installed on the box with ControlPort 9051
# and CookieAuthentication enabled. See deploy/tor/torrc.
Environment=HIVERELAY_TOR=1
Environment=HIVERELAY_TOR_SOCKS_HOST=127.0.0.1
Environment=HIVERELAY_TOR_SOCKS_PORT=9050
Environment=HIVERELAY_TOR_CONTROL_HOST=127.0.0.1
Environment=HIVERELAY_TOR_CONTROL_PORT=9051
Environment=HIVERELAY_TOR_KEY_FILE=/var/lib/hiverelay/tor-onion-key.blob
Environment=HIVERELAY_TOR_MIN_DAEMON_VERSION=0.4.9.5
# Restricted discovery: set HIVERELAY_TOR_ROSTER_FILE to an owner-readable
# roster containing one base32 x25519 client public key per line.

# Restart policy — RestartSec=15 prevents ELOCKED crash loops
# (random-access-file needs time to release primary-key lock)
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=5

# Shutdown — give graceful-goodbye time to close Hypercores/release locks
KillSignal=SIGTERM
TimeoutStopSec=10

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/hiverelay

# Resource limits
LimitNOFILE=65536
MemoryMax=2G

# Logging — stdout/stderr go to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hiverelay

[Install]
WantedBy=multi-user.target

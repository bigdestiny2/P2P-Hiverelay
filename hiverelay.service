[Unit]
Description=HiveRelay — P2P Relay Backbone
Documentation=https://github.com/hiverelay/hiverelay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hiverelay
Group=hiverelay

# Paths — adjust to your installation
ExecStart=/usr/bin/node /opt/hiverelay/cli/index.js start --storage /var/lib/hiverelay
WorkingDirectory=/opt/hiverelay

# Environment
Environment=NODE_ENV=production
Environment=HIVERELAY_LOG_LEVEL=info
Environment=HIVERELAY_REQUIRE_GENERATION_RECEIPT=1
Environment=HIVERELAY_GENERATION_RECEIPT=/etc/hiverelay/storage-generation-receipt.v1.json
Environment=HIVERELAY_GENERATION_RECEIPT_SHA256_FILE=/etc/hiverelay/storage-generation-receipt.v1.sha256
# Both files are offline ceremony outputs. The service fails before Corestore
# opens if either file is absent, mutable-root-local, non-canonical, or changed.
ReadOnlyPaths=/etc/hiverelay/storage-generation-receipt.v1.json
ReadOnlyPaths=/etc/hiverelay/storage-generation-receipt.v1.sha256
# Optional operator-declared planning label; choose from the documented
# bounded-capacity profiles only after measuring this host.
# Environment=HIVERELAY_CAPACITY_PROFILE=seeder-standard

# ─── Utility services (explicit opt-in) ────────────────────────────
# The authoritative Node-runtime choice is the reviewed plugins list persisted
# from the Services dashboard. A base relay must not silently become a
# multi-service storage host; zero defaults also keep future env wiring safe.
Environment=HIVERELAY_ENABLE_SERVICES=0
Environment=HIVERELAY_OUTBOXLOG=0
Environment=HIVERELAY_NOTIFY=0
Environment=HIVERELAY_STORAGE_PROOF=0
Environment=HIVERELAY_VRF=0
Environment=HIVERELAY_WITNESSLOG=0
Environment=HIVERELAY_REPAIRTICKET=0
Environment=HIVERELAY_SHARD_STORE=0

# Restart policy — RestartSec=15 prevents ELOCKED crash loops
# (random-access-file needs time to release primary-key lock)
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=5

# Shutdown — give graceful-goodbye time to close Hypercores/release locks
KillSignal=SIGTERM
TimeoutStopSec=10

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/hiverelay

# Resource limits
LimitNOFILE=65536
MemoryMax=2G

# Logging — stdout/stderr go to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hiverelay

[Install]
WantedBy=multi-user.target

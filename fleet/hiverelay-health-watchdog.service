[Unit]
Description=HiveRelay signed pidfd health watchdog (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C LC_ALL=C /bin/bash --noprofile --norc /usr/local/bin/hiverelay-health-watchdog.sh
Nice=10
UMask=0077
RuntimeDirectory=hiverelay-watchdog
RuntimeDirectoryMode=0700
StateDirectory=hiverelay-watchdog
StateDirectoryMode=0700
LogsDirectory=hiverelay-watchdog
LogsDirectoryMode=0700
ReadWritePaths=/run/hiverelay-watchdog /var/lib/hiverelay-watchdog /var/log/hiverelay-watchdog
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_KILL CAP_DAC_READ_SEARCH CAP_FOWNER CAP_CHOWN
TimeoutStartSec=150

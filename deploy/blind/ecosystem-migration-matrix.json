{
  "matrixVersion": 1,
  "matrixId": "hiverelay.blind.ecosystem-migration.v1",
  "decisionAuthority": "computed-code-owned-blockers-only",
  "authorizationRule": {
    "computedBy": "scripts/verify-blind-ecosystem-migration.mjs",
    "editableDecisionFields": "forbidden",
    "legacyRemovalPolicy": "deploy/blind/legacy-retirement-policy.json",
    "rule": "Application cutover and legacy-component removal are computed from code-owned production, gate, row-specific and retirement blockers. This matrix cannot authorize either action."
  },
  "boundaries": [
    {
      "id": "blind-relay-base",
      "allowedSurface": ["DESCRIBE", "CELL", "INBOX", "CORE", "FORWARD"],
      "owner": "relay-operator",
      "visibility": "Opaque canonical envelopes plus the minimum family, size-class, routing, lease and accounting metadata required by the selected primitive.",
      "forbiddenResponsibilities": ["application schemas", "application reducers", "semantic search", "business policy", "content moderation", "provider computation", "plaintext push payloads", "operator administration"]
    },
    {
      "id": "application-client",
      "allowedSurface": ["application state", "application schemas", "encryption keys", "signatures", "reducers", "derived indexes", "moderation policy"],
      "owner": "application-publisher-and-user",
      "visibility": "Application plaintext and semantics remain local unless the user explicitly discloses them to a named provider."
    },
    {
      "id": "nonblind-provider",
      "allowedSurface": ["explicitly disclosed provider request", "provider-specific result"],
      "owner": "separately identified provider",
      "visibility": "The provider may learn disclosed application inputs; it is not part of the blind relay trust boundary."
    },
    {
      "id": "nonblind-index",
      "allowedSurface": ["explicitly public or disclosed index input", "semantic query", "derived result"],
      "owner": "separately identified index operator",
      "visibility": "The index may learn indexed content and queries; it is optional and is not a blind relay feature."
    },
    {
      "id": "operator-control",
      "allowedSurface": ["loopback or private administration", "generic resource accounting", "release lifecycle"],
      "owner": "relay-operator",
      "visibility": "The control plane sees generic relay health and resource classes but no application namespace or payload semantics."
    }
  ],
  "externalDependencies": [
    {
      "id": "client-derived-index",
      "boundary": "application-client",
      "purpose": "Build feeds, graphs, search keys and materialized views from verified application records."
    },
    {
      "id": "signed-app-catalog",
      "boundary": "application-client",
      "purpose": "Publish and verify application-owned catalogs over CORE without turning DESCRIBE into an app registry."
    },
    {
      "id": "native-push-bridge",
      "boundary": "nonblind-provider",
      "purpose": "Translate explicitly disclosed notification metadata to platform push services."
    },
    {
      "id": "semantic-index-provider",
      "boundary": "nonblind-index",
      "purpose": "Offer optional search or discovery over content explicitly disclosed for indexing."
    },
    {
      "id": "ai-compute-provider",
      "boundary": "nonblind-provider",
      "purpose": "Run model inference on inputs explicitly disclosed by the user or application."
    },
    {
      "id": "payment-settlement-provider",
      "boundary": "nonblind-provider",
      "purpose": "Perform payment, compliance or settlement work outside the relay base."
    },
    {
      "id": "mobility-provider",
      "boundary": "nonblind-provider",
      "purpose": "Perform mapping, dispatch, geocoding or availability matching on disclosed inputs."
    },
    {
      "id": "realtime-media-provider",
      "boundary": "nonblind-provider",
      "purpose": "Provide optional TURN, transcoding, conferencing or live-media services when direct or blind FORWARD paths are insufficient."
    },
    {
      "id": "device-automation-provider",
      "boundary": "nonblind-provider",
      "purpose": "Execute device or automation commands on an explicitly paired endpoint."
    },
    {
      "id": "sports-data-provider",
      "boundary": "nonblind-provider",
      "purpose": "Supply licensed or centralized live sports data separately from blind transport."
    },
    {
      "id": "git-ci-provider",
      "boundary": "nonblind-provider",
      "purpose": "Run repository hosting bridges, builds or CI on explicitly supplied repository data."
    },
    {
      "id": "identity-arbitration-provider",
      "boundary": "nonblind-provider",
      "purpose": "Perform identity, witness, arbitration, schema, SLA, ZK or VRF services with an explicit provider contract."
    },
    {
      "id": "operator-admin-plane",
      "boundary": "operator-control",
      "purpose": "Configure, observe and roll back the generic relay without sharing the public data-plane listener."
    },
    {
      "id": "operator-accounting-plane",
      "boundary": "operator-control",
      "purpose": "Account for generic family and resource classes without application labels."
    }
  ],

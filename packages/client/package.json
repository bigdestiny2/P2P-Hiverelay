{
  "name": "p2p-hiverelay-client",
  "version": "0.23.0",
  "description": "Unified client SDK for HiveRelay (Core + Services). Talks to either via capability flags advertised by relay nodes.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./pairing.js": "./pairing.js",
    "./secret-sharing.js": "./secret-sharing.js",
    "./blind-shards.js": "./blind-shards.js",
    "./shard-transport.js": "./shard-transport.js",
    "./blind-custody.js": "./blind-custody.js",
    "./custody.js": "./custody.js",
    "./notify.js": "./notify.js"
  },
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "fs/promises": {
      "bare": "bare-fs/promises",
      "default": "fs/promises"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    }
  },
  "files": [
    "index.js",
    "pairing.js",
    "secret-sharing.js",
    "blind-shards.js",
    "shard-transport.js",
    "blind-custody.js",
    "custody.js",
    "notify.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "b4a": "^1.6.6",
    "bare-crypto": "^1.15.3",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.7.2",
    "bare-path": "^3.0.1",
    "corestore": "^6.18.0",
    "hyperdrive": "^11.8.0",
    "hyperswarm": "^4.17.0",
    "p2p-hiverelay": "^0.23.0",
    "sodium-universal": "^4.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigdestiny2/p2p-hiverelay",
    "directory": "packages/client"
  }
}

{
  "name": "p2p-hiverelay",
  "version": "0.26.0-rc.8",
  "description": "HiveRelay Core — minimal always-on P2P availability infrastructure (seeding, circuit relay, proof-of-relay, gateway)",
  "type": "module",
  "main": "core/index.js",
  "exports": {
    ".": {
      "bare": "./pear-entry.js",
      "default": "./core/index.js"
    },
    "./gateway": "./gateway/hyper-gateway.js",
    "./core/custody-signing": "./core/custody-signing.js",
    "./core/custody-signing.js": "./core/custody-signing.js",
    "./core/pvss": "./core/pvss.js",
    "./core/pvss.js": "./core/pvss.js",
    "./core/constants": "./core/constants.js",
    "./core/constants.js": "./core/constants.js",
    "./core/protocol/custody-channel": "./core/protocol/custody-channel.js",
    "./core/protocol/custody-channel.js": "./core/protocol/custody-channel.js",
    "./core/protocol/publish-channel": "./core/protocol/publish-channel.js",
    "./core/protocol/publish-channel.js": "./core/protocol/publish-channel.js",
    "./core/protocol/seed-request": "./core/protocol/seed-request.js",
    "./core/protocol/seed-request.js": "./core/protocol/seed-request.js",
    "./gateway/exact-app-context": null,
    "./gateway/exact-app-context.js": null,
    "./*": "./*"
  },
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "fs/promises": {
      "bare": "bare-fs/promises",
      "default": "fs/promises"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "http": {
      "bare": "bare-http1",
      "default": "http"
    }
  },
  "pear": {
    "name": "p2p-hiverelay",
    "type": "terminal",
    "main": "pear-entry.js"
  },
  "bin": {
    "p2p-hiverelay": "./cli/index.js",
    "hiverelay": "./cli/index.js"
  },
  "files": [
    "cli/",
    "core/",
    "gateway/",
    "config/",
    "incentive/",
    "transports/",
    "platform/",
    "pear-entry.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.7.15",
    "@hyperswarm/secret-stream": "^6.9.1",
    "@inquirer/prompts": "^8.4.1",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "b4a": "^1.8.1",
    "bare-crypto": "^1.15.3",
    "bare-events": "^2.9.1",
    "bare-fs": "^4.7.2",
    "bare-http1": "^4.5.7",
    "bare-path": "^3.0.1",
    "compact-encoding": "^3.3.0",
    "corestore": "^7.11.0",
    "device-file": "^2.3.1",
    "distributed-drive": "^0.1.1",
    "fd-lock": "^2.2.0",
    "holesail": "^2.4.1",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.33.5",
    "hyperdht": "^6.15.0",
    "hyperdrive": "^13.3.2",
    "hyperswarm": "^4.17.0",
    "minimist": "^1.2.8",
    "multicast-dns": "^7.2.5",
    "paparam": "^1.10.1",
    "pear-gracedown": "^1.0.3",
    "pino": "^9.0.0",
    "protomux": "^3.11.0",
    "socks": "^2.8.7",
    "sodium-universal": "^5.0.1",
    "which-runtime": "^1.4.0",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigdestiny2/p2p-hiverelay",
    "directory": "packages/core"
  }
}

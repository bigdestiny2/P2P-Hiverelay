{
  "name": "p2p-hiverelay",
  "version": "0.27.0-rc.1",
  "description": "HiveRelay Core \u2014 minimal always-on P2P availability infrastructure (seeding, circuit relay, proof-of-relay, gateway)",
  "type": "module",
  "main": "core/index.js",
  "exports": {
    ".": {
      "bare": "./pear-entry.js",
      "default": "./core/index.js"
    },
    "./gateway": "./gateway/hyper-gateway.js",
    "./core/custody-signing": "./core/custody-signing.js",
    "./core/custody-signing.js": "./core/custody-signing.js",
    "./core/pvss": "./core/pvss.js",
    "./core/pvss.js": "./core/pvss.js",
    "./core/constants": "./core/constants.js",
    "./core/constants.js": "./core/constants.js",
    "./core/protocol/custody-channel": "./core/protocol/custody-channel.js",
    "./core/protocol/custody-channel.js": "./core/protocol/custody-channel.js",
    "./core/protocol/publish-channel": "./core/protocol/publish-channel.js",
    "./core/protocol/publish-channel.js": "./core/protocol/publish-channel.js",
    "./core/protocol/seed-request": "./core/protocol/seed-request.js",
    "./core/protocol/seed-request.js": "./core/protocol/seed-request.js",
    "./gateway/exact-app-context": null,
    "./gateway/exact-app-context.js": null,
    "./*": "./*"
  },
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "fs/promises": {
      "bare": "bare-fs/promises",
      "default": "fs/promises"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "http": {
      "bare": "bare-http1",
      "default": "http"
    }
  },
  "pear": {
    "name": "p2p-hiverelay",
    "type": "terminal",
    "main": "pear-entry.js"
  },
  "bin": {
    "p2p-hiverelay": "./cli/index.js",
    "hiverelay": "./cli/index.js"
  },
  "scripts": {
    "postinstall": "node platform/apply-hypercore-storage-migration-patch.js"
  },
  "files": [
    "cli/",
    "core/",
    "gateway/",
    "config/",
    "incentive/",
    "transports/",
    "platform/",
    "patches/",
    "pear-entry.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "^0.7.15",
    "@hyperswarm/secret-stream": "6.9.2",
    "@inquirer/prompts": "^8.4.1",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@x402/core": "2.30.0",
    "@x402/evm": "2.30.0",
    "b4a": "1.9.0",
    "bare-crypto": "1.15.4",
    "bare-events": "2.9.2",
    "bare-fs": "4.8.4",
    "bare-http1": "4.6.3",
    "bare-path": "3.1.3",
    "blind-relay": "1.6.1",
    "compact-encoding": "3.7.0",
    "corestore": "7.16.1",
    "device-file": "2.3.1",
    "distributed-drive": "0.1.1",
    "fd-lock": "2.2.0",
    "fs-native-extensions": "1.5.3",
    "holesail": "2.4.4",
    "hyperbee": "2.27.3",
    "hypercore": "11.40.4",
    "hypercore-id-encoding": "1.3.0",
    "hypercore-storage": "3.4.0",
    "hyperdht": "6.36.0",
    "hyperdrive": "13.3.4",
    "hyperswarm": "4.17.2",
    "minimist": "^1.2.8",
    "multicast-dns": "^7.2.5",
    "paparam": "1.15.0",
    "pear-gracedown": "1.0.5",
    "pino": "^9.0.0",
    "protomux": "3.13.1",
    "punycode": "^2.3.1",
    "socks": "^2.8.7",
    "sodium-universal": "5.0.1",
    "which-runtime": "1.4.0",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigdestiny2/p2p-hiverelay",
    "directory": "packages/core"
  }
}
